@using Microsoft.AspNetCore.Identity;
@using UpsConnectService.Models.Users;
@using UpsConnectService.Controllers.Account;
@inject UserManager<User> UserManager;
@inject SignInManager<User> SignInManager

@model UpsConnectService.ViewModels.Users.LoginViewModel

@{
    ViewData["Title"] = "Home Page";
}

<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

@if (SignInManager.IsSignedIn(User))
{
    <meta http-equiv="refresh" content="0; URL= ../ServiceView" />
}
else
{
    <div class="row">
        <div class="side">
            <div class="center">
                Система мониторинга технического состояния РЭП
            </div>       
        </div>

        <div class="main">
            <partial name="Login"/> 
        </div>
    </div>
}