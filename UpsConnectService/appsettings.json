{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=UpsConnectService;Trusted_Connection=True;TrustServerCertificate=true;"
  },
  "Limits": {
    "MaxConcurrentConnections": 100,
    "MaxRequestBodySize": 52428800
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    },
    "File": {
      "Path": "Logs/log-.txt",
      "Append": true,
      "FileSizeLimitBytes": 10485760,
      "RetainedFileCountLimit": 5
    }
  }
}